"use strict";
var table = document.querySelector(".field");
var appendRow = document.querySelector(".append-row");
var appendColumn = document.querySelector(".append-column");
var removeRow = document.querySelector(".remove-row");
var removeColumn = document.querySelector(".remove-column");
var MAX_ROWS = 10;
var MAX_COLUMNS = 10;
appendRow.addEventListener("click", function() {
    var rowCount = table.rows.length;
    var colCount = table.rows[0].cells.length;
    if (rowCount >= MAX_ROWS) {
        appendRow.disabled = true;
        return;
    }
    var newRow = table.insertRow();
    for(var i = 0; i < colCount; i++)newRow.insertCell();
    // Вмикаємо removeRow, якщо є більше ніж 2 рядки
    if (table.rows.length > 2) removeRow.disabled = false;
});
appendColumn.addEventListener("click", function() {
    var colCount = table.rows[0].cells.length;
    if (colCount >= MAX_COLUMNS) {
        appendColumn.disabled = true;
        return;
    }
    Array.from(table.rows).forEach(function(row) {
        row.insertCell();
    });
    // Вмикаємо removeColumn, якщо є більше ніж 2 колонки
    if (table.rows[0].cells.length > 2) removeColumn.disabled = false;
});
removeRow.addEventListener("click", function() {
    if (table.rows.length > 2) table.deleteRow(-1);
    if (table.rows.length <= 2) removeRow.disabled = true;
    if (table.rows.length > 2) appendRow.disabled = false;
});
removeColumn.addEventListener("click", function() {
    var colCount = table.rows[0].cells.length;
    if (colCount > 2) Array.from(table.rows).forEach(function(row) {
        row.deleteCell(-1);
    });
    if (colCount <= 2) removeColumn.disabled = true;
    if (colCount > 2) appendColumn.disabled = false;
});

